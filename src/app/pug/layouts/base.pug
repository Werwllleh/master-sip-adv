include ../../pug/index
include ../../../components/index
include ../../../blocks/index

block vars
    - var stylesLibs = []
    - var scriptsLibs = []
    - var stylesComponents = []
    - var scriptsComponents = []
    - var stylesBlocks = []
    - var scriptsBlocks = []
    - var stylePage = ''
    - var scriptPage = ''

    - var title = "Document"
    - var description = "Document description"

block use

+regLibrary('', 'input-mask/input-mask.js')
+regLibrary('', 'config/config.js')

doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        base(href="./")
        title= title
        meta(name="description" content="" + description)
        link(rel="stylesheet", href=`css/style.css`)
    body
        +header()
        main.page
            .page__content
                block content
        .background-image
            img(src="./images/background-image.webp", alt="Фон")
        +footer()


        .styles-libs
            // Стили библиотек
            each style in stylesLibs
                link(rel="stylesheet", href=`libs/${style}`)

        // Скрипты библиотек
        each script in scriptsLibs
            script(src=`/libs/${script}`)
        // Скрипты общие
        script(src=`js/common.js`)
        include ../../../sprite/sprite.svg
